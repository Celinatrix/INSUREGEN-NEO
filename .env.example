# Sao chép thành .env.local khi chạy trên máy, hoặc khai báo trong Vercel → Settings → Environment Variables.

# Địa chỉ trang sau khi deploy (dùng cho thẻ chia sẻ mạng xã hội)
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Supabase → Project Settings → API. Khóa service role CHỈ đặt ở máy chủ, không bao giờ đưa lên trình duyệt.
# Bỏ trống thì máy chủ lưu tạm trong bộ nhớ (mất khi khởi động lại).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Bật AI đọc giấy ra viện. Bỏ trống thì người dùng nhập ngày tay.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
